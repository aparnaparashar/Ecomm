<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="meridian-page">
  <header class="meridian-page-header">
    <div class="header-container">
      <span class="header-pre">The Guild of Artisans</span>
      <h1 class="header-main-title">Resident Master Couturiers</h1>
      <p class="header-desc">
        Every Meridian piece is envisioned, draped, and perfected by internationally acclaimed designers from Milan, Paris, New Delhi, Lyon, and Tokyo.
      </p>
      <div class="gold-accent-line"></div>
    </div>
  </header>

  <section class="meridian-section designers-section">
    <div class="designers-grid-container">

      <!-- Designer 1: Alessandro Rossi -->
      <article class="designer-card">
        <div class="designer-media">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800" alt="Alessandro Rossi" class="designer-photo">
          <div class="designer-origin-badge"><i class="fas fa-map-pin"></i> Milan, Italy</div>
        </div>
        <div class="designer-info">
          <span class="designer-title-pre">Head of Menswear & Sartorial Architecture</span>
          <h2 class="designer-full-name">Alessandro Rossi</h2>
          <p class="designer-bio">
            Trained in Savile Row and Milan’s Quadrilatero della Moda, Alessandro orchestrates heavyweight virgin wools, Loro Piana cashmeres, and hand-stitched canvassing into power silhouettes that command boardroom and gala alike.
          </p>
          <div class="designer-signatures">
            <strong>Signature Medium:</strong> Loro Piana 130s Virgin Wool & Italian Cashmere
          </div>
          <div class="designer-cta">
            <a href="/products/search?search=Rossi" class="meridian-btn btn-outline btn-sm">Explore Alessandro's Pieces</a>
          </div>
        </div>
      </article>

      <!-- Designer 2: Elena Rostova -->
      <article class="designer-card">
        <div class="designer-media">
          <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=800" alt="Elena Rostova" class="designer-photo">
          <div class="designer-origin-badge"><i class="fas fa-map-pin"></i> Paris, France</div>
        </div>
        <div class="designer-info">
          <span class="designer-title-pre">Directrice of Haute Evening Drapery</span>
          <h2 class="designer-full-name">Elena Rostova</h2>
          <p class="designer-bio">
            Former atelier lead at Paris Haute Couture Week, Elena specializes in micro-pleated 24-momme mulberry silks, bias cut gowns, and sculpted eveningwear that moves like liquid mercury.
          </p>
          <div class="designer-signatures">
            <strong>Signature Medium:</strong> Mulberry Silk Chiffon, Duchesse Satin & Organza
          </div>
          <div class="designer-cta">
            <a href="/products/search?search=Rostova" class="meridian-btn btn-outline btn-sm">Explore Elena's Pieces</a>
          </div>
        </div>
      </article>

      <!-- Designer 3: Aarav Mehra -->
      <article class="designer-card">
        <div class="designer-media">
          <img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=800" alt="Aarav Mehra" class="designer-photo">
          <div class="designer-origin-badge"><i class="fas fa-map-pin"></i> New Delhi, India</div>
        </div>
        <div class="designer-info">
          <span class="designer-title-pre">Master of Heritage Brocades & Zardozi Tapestry</span>
          <h2 class="designer-full-name">Aarav Mehra</h2>
          <p class="designer-bio">
            Synthesizing ancestral Varanasi handloom traditions with contemporary structure, Aarav infuses pure mulberry silk and silk-velvet with hand-hammered antique brass bullion zardozi and real silver zari threadwork.
          </p>
          <div class="designer-signatures">
            <strong>Signature Medium:</strong> Kashi Kadwa Brocade & Hand-Spun Royal Silk Velvet
          </div>
          <div class="designer-cta">
            <a href="/products/search?search=Mehra" class="meridian-btn btn-outline btn-sm">Explore Aarav's Pieces</a>
          </div>
        </div>
      </article>

      <!-- Designer 4: Claire Laurent -->
      <article class="designer-card">
        <div class="designer-media">
          <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=800" alt="Claire Laurent" class="designer-photo">
          <div class="designer-origin-badge"><i class="fas fa-map-pin"></i> Lyon, France</div>
        </div>
        <div class="designer-info">
          <span class="designer-title-pre">Curator of Minimalist Luxury & Daywear</span>
          <h2 class="designer-full-name">Claire Laurent</h2>
          <p class="designer-bio">
            Hailing from the silk capital of Lyon, Claire balances austere brutalist geometry with the world’s softest grade-A Mongolian cashmere, creating effortless heirloom coats and cocoon capes.
          </p>
          <div class="designer-signatures">
            <strong>Signature Medium:</strong> Double-Faced Baby Alpaca & Mongolian Cashmere
          </div>
          <div class="designer-cta">
            <a href="/products/search?search=Laurent" class="meridian-btn btn-outline btn-sm">Explore Claire's Pieces</a>
          </div>
        </div>
      </article>

      <!-- Designer 5: Kenji Takahashi -->
      <article class="designer-card">
        <div class="designer-media">
          <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800" alt="Kenji Takahashi" class="designer-photo">
          <div class="designer-origin-badge"><i class="fas fa-map-pin"></i> Tokyo, Japan</div>
        </div>
        <div class="designer-info">
          <span class="designer-title-pre">Architect of Technical Avant-Garde Draping</span>
          <h2 class="designer-full-name">Kenji Takahashi</h2>
          <p class="designer-bio">
            Pioneering a synthesis of Japanese high-density waterproof matte gabardine, origami-inspired modular closures, and zero-waste draping patterns that redefine high-fashion utility.
          </p>
          <div class="designer-signatures">
            <strong>Signature Medium:</strong> Bonded Japanese Gabardine & Obsidian Coated Cotton
          </div>
          <div class="designer-cta">
            <a href="/products/search?search=Takahashi" class="meridian-btn btn-outline btn-sm">Explore Kenji's Pieces</a>
          </div>
        </div>
      </article>

    </div>
  </section>
</main>

<%- include('../partials/footer') %>
