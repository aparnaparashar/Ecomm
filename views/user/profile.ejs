<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="meridian-page">
  <header class="meridian-page-header">
    <div class="header-container">
      <span class="header-pre">Client Portfolio</span>
      <h1 class="header-main-title">Welcome, <%= user.username %></h1>
      <div class="gold-accent-line"></div>
    </div>
  </header>

  <section class="meridian-section profile-section">
    <div class="profile-layout-container">
      
      <!-- User Profile Card -->
      <aside class="profile-sidebar-card">
        <div class="user-avatar-circle">
          <span class="avatar-glyph"><%= user.username.charAt(0).toUpperCase() %></span>
        </div>
        <h3 class="user-name"><%= user.username %></h3>
        <p class="user-email"><%= user.email %></p>
        
        <% if (user.isAdmin) { %>
          <div class="admin-badge-pill">
            <i class="fas fa-crown"></i> Atelier Curator (Admin)
          </div>
          <a href="/admin" class="meridian-btn btn-outline btn-block mt-3">
            Open Atelier Console
          </a>
        <% } %>

        <hr class="profile-sep">

        <div class="profile-meta-list">
          <p><i class="fas fa-shield-alt gold-text"></i> Bcrypt Encrypted Profile</p>
          <p><i class="fas fa-calendar-alt gold-text"></i> Client since <%= new Date(user.createdAt).getFullYear() %></p>
        </div>

        <a href="/user/logout" class="meridian-btn btn-outline btn-block mt-3">
          Sign Out Gracefully
        </a>
      </aside>

      <!-- Order History (Experiment 3: Display state of order) -->
      <div class="profile-orders-main">
        <h2 class="orders-heading">Acquisition History & Order Ledger</h2>
        <div class="gold-accent-line" style="margin: 0 0 30px 0;"></div>

        <% if (orders && orders.length > 0) { %>
          <div class="orders-timeline">
            <% orders.forEach(order => { %>
              <div class="order-receipt-card">
                
                <div class="order-card-header">
                  <div>
                    <span class="order-tag">Order Reference</span>
                    <h4 class="order-ref-title">#<%= order._id.toString().slice(-8).toUpperCase() %></h4>
                    <small class="order-date"><%= new Date(order.createdAt).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></small>
                  </div>
                  
                  <div class="order-status-badge <%= order.delivered ? 'status-delivered' : 'status-processing' %>">
                    <i class="fas fa-<%= order.delivered ? 'check-circle' : 'shipping-fast' %>"></i>
                    <%= order.delivered ? 'DELIVERED' : 'IN TRANSIT / CRAFTING' %>
                  </div>
                </div>

                <div class="order-card-body">
                  <div class="order-items-table">
                    <% order.cart.items.forEach(item => { %>
                      <div class="order-piece-row">
                        <div>
                          <strong><%= item.title %></strong>
                          <span class="code-sub">Ref: <%= item.productCode %></span>
                        </div>
                        <div class="order-piece-qty">Qty: <%= item.qty %></div>
                        <div class="order-piece-price">₹<%= item.price.toLocaleString('en-IN') %></div>
                      </div>
                    <% }) %>
                  </div>

                  <div class="order-card-footer">
                    <div class="order-shipping-dest">
                      <i class="fas fa-map-pin gold-text"></i>
                      <span><strong>Dispatch To:</strong> <%= order.address %></span>
                    </div>
                    <div class="order-grand-total">
                      <span>Total Billed:</span>
                      <strong>₹<%= order.cart.totalCost.toLocaleString('en-IN') %></strong>
                    </div>
                  </div>
                </div>

              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <p>You have not acquired any pieces yet.</p>
            <a href="/products" class="meridian-btn btn-primary">Browse Autumn Runway</a>
          </div>
        <% } %>
      </div>

    </div>
  </section>
</main>

<%- include('../partials/footer') %>
