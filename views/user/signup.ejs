<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="meridian-page auth-page">
  <div class="auth-box-card">
    
    <div class="auth-header">
      <h1 class="auth-title">Join The House</h1>
      <p class="auth-subtitle">Create your bespoke Meridian client account</p>
      <div class="gold-accent-line"></div>
    </div>

    <!-- Client-side & Express-Validator server-side validation (Experiment 4) -->
    <form action="/user/signup" method="POST" class="meridian-form auth-form">
      
      <div class="form-group">
        <label for="name">Full Name *</label>
        <div class="input-with-icon">
          <i class="fas fa-user input-icon"></i>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-control" 
            required 
            placeholder="e.g. Aparna Sharma"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="email">Email Address *</label>
        <div class="input-with-icon">
          <i class="fas fa-envelope input-icon"></i>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-control" 
            required 
            placeholder="client@meridian.style"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="password">Password (Minimum 4 characters) *</label>
        <div class="input-with-icon">
          <i class="fas fa-lock input-icon"></i>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control" 
            required 
            minlength="4"
            placeholder="••••••••"
          >
        </div>
      </div>

      <div class="form-group">
        <label for="password2">Confirm Password *</label>
        <div class="input-with-icon">
          <i class="fas fa-check-double input-icon"></i>
          <input 
            type="password" 
            id="password2" 
            name="password2" 
            class="form-control" 
            required 
            minlength="4"
            placeholder="••••••••"
          >
        </div>
      </div>

      <div class="form-group admin-optional">
        <label for="adminSecret"><small>Curator Key (Optional)</small></label>
        <input 
          type="password" 
          id="adminSecret" 
          name="adminSecret" 
          class="form-control form-control-compact" 
          placeholder="Curator authorization key (if applicable)"
        >
      </div>

      <button type="submit" class="meridian-btn btn-primary btn-block btn-lg">
        Create Client Profile
      </button>

      <div class="auth-footer-prompt">
        <p>Already registered with Meridian? <a href="/user/signin">Sign In</a></p>
      </div>

    </form>
  </div>
</main>

<%- include('../partials/footer') %>
